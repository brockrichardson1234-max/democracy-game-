{
  "name": "democracy-game",
  "version": "0.1.0",
  "private": true,
  "description": "Systemic political strategy simulation walking-skeleton runtime.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.sim.json --pretty false && tsc -p tsconfig.json --pretty false",
    "lint": "eslint .",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:pop0-i1-boundaries": "node scripts/check-pop0-i1-boundaries.mjs",
    "check:production-runtime": "node scripts/check-production-runtime-imports.mjs",
    "check:built-production-runtime": "node scripts/check-built-production-runtime.mjs",
    "verify:us-topology-artifacts": "node scripts/verify-us-topology-artifacts.mjs",
    "verify:us-i4-artifacts": "node scripts/verify-us-i4-artifacts.mjs",
    "build:us-i6-artifacts": "node scripts/build-us-i6-artifacts.mjs",
    "verify:us-i6-artifacts": "node scripts/verify-us-i6-artifacts.mjs",
    "build:us-i7-artifacts": "node scripts/build-us-i7-artifacts.mjs",
    "verify:us-i7-artifacts": "node scripts/verify-us-i7-artifacts.mjs",
    "verify": "npm run typecheck && npm run check:boundaries && npm run check:pop0-i1-boundaries && npm run check:production-runtime && npm run verify:us-topology-artifacts && npm run verify:us-i4-artifacts && npm run verify:us-i6-artifacts && npm run verify:us-i7-artifacts && npm run lint && npm test && npm run build && npm run check:built-production-runtime"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.10.3",
    "eslint": "^9.39.1",
    "fflate": "^0.8.2",
    "globals": "^16.5.0",
    "pdfjs-dist": "^6.2.108",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.4"
  }
}
